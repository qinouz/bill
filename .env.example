# 云开发环境配置
VITE_CLOUD_ENV_ID=your-env-id

# API 配置
VITE_API_BASE_URL=https://api.example.com

# 微信小程序配置
VITE_WECHAT_APPID=your-appid

# ========== 云函数环境变量（在微信云控制台配置） ==========
# 以下变量需要在微信云开发控制台 → 设置 → 环境变量 中配置

# 腾讯云 ASR 语音识别配置
# 获取地址：https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# MiMo (硅基流动) API 配置
# 获取地址：https://cloud.siliconflow.cn/account/ak
MIMO_API_KEY=your-siliconflow-api-key
